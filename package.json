{
  "name": "llave-inglesa",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Simulador offline de esquemas de custodia Bitcoin: backups, multisig, herencia y ataques.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @llave-inglesa/web",
    "build": "npm run build -w @llave-inglesa/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "check": "npm run typecheck && npm run test",
    "analyze": "tsx apps/cli/src/main.ts analyze",
    "e2e": "npm run e2e -w @llave-inglesa/web",
    "empaquetar": "npm run build && python3 scripts/empaquetar.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
