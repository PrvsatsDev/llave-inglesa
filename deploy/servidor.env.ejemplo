# Copia este fichero como deploy/servidor.env (no se sube al repo) y pon los datos de tu servidor.

# Dominio con el que se sirve la web (Caddy pide el certificado HTTPS solo).
DOMINIO=llave-inglesa.example.net
# Carpeta del servidor donde se guardan las versiones y el enlace `actual`.
RAIZ=/srv/llave-inglesa
# Alias de ~/.ssh/config con el usuario y la clave de despliegue.
SSH_HOST=llave-inglesa
# Versiones que se conservan en el servidor (opcional).
CONSERVAR=5
